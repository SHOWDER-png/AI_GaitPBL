 *       uncomment and fill in. Record the choice in hardware/PLANTAR_WIRING.md.
 *
 * &i2cX {
 *	ads1115_a: ads1115@48 {
 *		compatible = "ti,ads1115";
 *		reg = <0x48>;
 *		#io-channel-cells = <1>;
 *	};
 *	ads1115_b: ads1115@49 {
 *		compatible = "ti,ads1115";
 *		reg = <0x49>;
 *		#io-channel-cells = <1>;
 *	};
 * };
 */
