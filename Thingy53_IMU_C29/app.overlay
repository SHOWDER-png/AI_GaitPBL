/ {
    zephyr,user {
        io-channels = <&adc 0>;
    };
};

/* Enable ADC for FSR402 */
&adc {
    status = "okay";

    #address-cells = <1>;
    #size-cells = <0>;

    channel@0 {
        reg = <0>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN0>;
        zephyr,resolution = <12>;
    };
};

/* Original BMI270 configuration from Kaan */
&bmi270 {
    status = "okay";
};
